# Solana RPC (using public for development, switch to Helius for production)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

# Telegram Bot (REQUIRED - get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ============================================
# DATABASE OPTIONS (choose one)
# ============================================

# OPTION 1: Neon (Free PostgreSQL) - https://neon.tech
# 1. Sign up at https://neon.tech (free, no credit card)
# 2. Create a project
# 3. Copy your connection string
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# OPTION 2: Local PostgreSQL (if installed)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/trench

# ============================================
# REDIS OPTIONS (choose one)  
# ============================================

# OPTION 1: Upstash (Free Redis) - https://upstash.com
# 1. Sign up at https://upstash.com (free, no credit card)
# 2. Create a Redis database
# 3. Copy your REST URL
REDIS_URL=rediss://default:xxx@us1-xxx.upstash.io:6379

# OPTION 2: Skip Redis (alerts will work but no rate limiting)
# REDIS_URL=

# OPTION 3: Local Redis (if installed)
# REDIS_URL=redis://localhost:6379/0

# ============================================
# Alert Settings
# ============================================
ALERT_COOLDOWN_SECONDS=30
MIN_TRANSACTION_SOL=0.1

# Fresh Wallet Thresholds
FRESH_WALLET_MAX_AGE_DAYS=7
DORMANT_WALLET_MIN_INACTIVE_DAYS=30

# Whale Thresholds
WHALE_THRESHOLD_SOL=15.0
DOLPHIN_THRESHOLD_SOL=5.0

# Dormant Wallet Settings
MIN_DORMANT_SOL=3.0
DORMANT_MIN_DAYS=4
DORMANT_OLD_DAYS=8

# Separate Telegram Channels (leave empty to use main channel)
TELEGRAM_DORMANTS_CHAT_ID=
