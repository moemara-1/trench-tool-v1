# Solana RPC (using public for development, switch to Helius for production)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
SOLANA_FALLBACK_WS_SUPPORTS_LOG_SUBSCRIPTIONS=false
SOLANA_PREFER_FALLBACK_RPC=false
SOLANA_RPC_CONCURRENCY=1
SOLANA_TX_FETCH_DELAY_SECONDS=3.0
HELIUS_API_KEYS=

# EVM providers for V2 command scans, launches, approvals, and wallet history
ALCHEMY_API_KEY=
ETHERSCAN_API_KEY=
GOPLUS_API_KEY=
HONEYPOT_API_KEY=
MORALIS_API_KEY=
BITQUERY_API_KEY=
# Robinhood Chain mainnet (chain ID 4663). Use the public endpoint until the
# ROBINHOOD_MAINNET network is enabled for the configured Alchemy app.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
V2_COMMAND_PROVIDERS_ENABLED=true
V2_SOLANA_PROVIDER_HEALTH_ENABLED=false

# Telegram Bot (REQUIRED - get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ============================================
# DATABASE OPTIONS (choose one)
# ============================================

# OPTION 1: Neon (Free PostgreSQL) - https://neon.tech
# 1. Sign up at https://neon.tech (free, no credit card)
# 2. Create a project
# 3. Copy your connection string
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# OPTION 2: Local PostgreSQL (if installed)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/trench

# ============================================
# REDIS OPTIONS (choose one)  
# ============================================

# OPTION 1: Upstash (Free Redis) - https://upstash.com
# 1. Sign up at https://upstash.com (free, no credit card)
# 2. Create a Redis database
# 3. Copy your REST URL
REDIS_URL=rediss://default:xxx@us1-xxx.upstash.io:6379

# OPTION 2: Skip Redis (alerts will work but no rate limiting)
# REDIS_URL=

# OPTION 3: Local Redis (if installed)
# REDIS_URL=redis://localhost:6379/0

# ============================================
# Alert Settings
# ============================================
ALERT_COOLDOWN_SECONDS=30
MIN_TRANSACTION_SOL=0.1

# Fresh Wallet Thresholds
FRESH_WALLET_MAX_AGE_DAYS=7
DORMANT_WALLET_MIN_INACTIVE_DAYS=30

# Whale Thresholds
WHALE_THRESHOLD_SOL=15.0
DOLPHIN_THRESHOLD_SOL=5.0

# Dormant Wallet Settings
MIN_DORMANT_SOL=3.0
DORMANT_MIN_DAYS=4
DORMANT_OLD_DAYS=8

# Separate Telegram Channels (leave empty to use main channel)
TELEGRAM_DORMANTS_CHAT_ID=

# Telegram forum topic IDs. Keep disabled as 0 locally; production should wire
# each active producer to a real topic so alerts never fall back to General.
TELEGRAM_FRESHIES_TOPIC_ID=0
TELEGRAM_DORMANTS_TOPIC_ID=0
TELEGRAM_PATTERNS_TOPIC_ID=0
TELEGRAM_WIZARD_TOPIC_ID=0
TELEGRAM_BUNDLES_TOPIC_ID=0
TELEGRAM_SNS_TOPIC_ID=0
TELEGRAM_STREAMFLOW_TOPIC_ID=0
TELEGRAM_DEV_HELD_TOPIC_ID=0
TELEGRAM_GOOD_CREATOR_TOPIC_ID=0
TELEGRAM_SOCIALS_TOPIC_ID=0
TELEGRAM_STRONG_LAUNCH_TOPIC_ID=0
TELEGRAM_STRONGFLOOR_TOPIC_ID=0
TELEGRAM_FEEDBACK_TOPIC_ID=0
TELEGRAM_BEST_SIGNALS_TOPIC_ID=0
TELEGRAM_ETH_FRESHIES_TOPIC_ID=0
TELEGRAM_ETH_BIG_FRESHIES_TOPIC_ID=0
TELEGRAM_ETH_LOW_MC_FRESHIES_TOPIC_ID=0
TELEGRAM_BASE_FRESHIES_TOPIC_ID=0
TELEGRAM_BASE_LOW_MC_FRESHIES_TOPIC_ID=0
TELEGRAM_BASE_DEPLOYS_TOPIC_ID=0
TELEGRAM_BNB_FRESHIES_TOPIC_ID=0
TELEGRAM_BNB_BIG_FRESHIES_TOPIC_ID=0
TELEGRAM_BNB_LOW_MC_FRESHIES_TOPIC_ID=0
V2_SIGNAL_DAILY_CAP=0
V2_SIGNAL_TOPIC_DAILY_CAP=5
V2_SIGNAL_MAX_ALERTS_PER_CYCLE=14
V2_SIGNAL_MIN_QUALITY=82
BEST_SIGNALS_DAILY_CAP=0
BEST_SIGNALS_MIN_SCORE=96
BEST_SIGNALS_MIN_CONFLUENCE_SOURCES=2
BEST_SIGNALS_CONFLUENCE_WINDOW_MINUTES=45
BEST_SIGNALS_MIN_CONFLUENCE_COMPONENT_SCORE=90
BEST_SIGNALS_SOLANA_DAILY_CAP=3
BEST_SIGNALS_SOLANA_COOLDOWN_MINUTES=60
BEST_WALLET_SIGNALS_ENABLED=true
BEST_WALLET_MIN_SCORE=92
TELEGRAM_BEST_WALLETS_WEEK_TOPIC_ID=0
TELEGRAM_BEST_WALLETS_MONTH_TOPIC_ID=0
TELEGRAM_BEST_WALLETS_YEAR_TOPIC_ID=0
TELEGRAM_BEST_WALLET_CONFLUENCE_TOPIC_ID=0
TELEGRAM_RH_FRESHIES_TOPIC_ID=0
TELEGRAM_RH_BIG_FRESHIES_TOPIC_ID=0
TELEGRAM_RH_LOW_MC_FRESHIES_TOPIC_ID=0
TELEGRAM_RH_DEPLOYS_TOPIC_ID=0
SOLANA_WS_STALE_SECONDS=300
